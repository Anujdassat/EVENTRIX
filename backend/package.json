  "version": "1.0.0",
  "description": "ByteVox Event Ticket Booking & Seat Reservation System Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
